{
  "builds": [
    {
      "src": "main.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "50mb",
        "includeFiles": [
          "index.html",
          "banner1.gif",
          "banner2.gif",
          "banner3.gif",
          "apple-touch-icon.png",
          "favicon-32.png",
          "favicon.png",
          "logo.png",
          "favicon.ico",
          "favicon-16.png",
          "icon-192.png"
        ]
      }
    }
  ],
  "routes": [
    { "src": "/(.*)", "dest": "main.py" }
  ]
}
